# 复制为 .env 后修改。不要把 .env 提交到仓库。
# 生成随机串：openssl rand -hex 32

# 只监听本机。nginx 再反代到这个端口。
APP_PORT=18200
MEM_LIMIT=512m
MEMSWAP_LIMIT=768m
CPU_LIMIT=1.0

APP_ENV=production
# 容器内由 docker-compose 覆盖为 /data。本机直接跑 uvicorn 时可保持 ./data
DATA_DIR=./data
# 留空使用 SQLite：${DATA_DIR}/app.db
# Postgres 示例（镜像已含 psycopg，不自带数据库容器）：
# DATABASE_URL=postgresql+psycopg://dh:dh@127.0.0.1:5432/dhadmin
DATABASE_URL=

JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_EXPIRE_MINUTES=10080

# 任意长随机串即可，程序会派生加密密钥。也可以填 Fernet.generate_key()
ENCRYPTION_KEY=REPLACE_WITH_FERNET_OR_RANDOM_32_BYTE_KEY

# 仅在数据库里还没有管理员时使用。之后请在「设置」里改密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# LiveTalking 调用 /api/runtime 和 /v1/chat/completions 时携带
RUNTIME_API_TOKEN=REPLACE_WITH_LONG_RANDOM_RUNTIME_TOKEN
LIVETALKING_URL=http://127.0.0.1:8010

# SQLite 建议保持 1。多个 worker 容易写锁。
UVICORN_WORKERS=1
MAX_UPLOAD_MB=200

# 仅本地 vite 开发时需要，生产同域不用
# CORS_ORIGINS=http://127.0.0.1:5174
