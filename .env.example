# LiveTalking 根目录环境变量示例（复制为 .env 后修改，勿提交 .env）

# ---- 可选：通过 dh-admin 代理 LLM ----
DH_ADMIN_BASE_URL=http://127.0.0.1:18200
DH_ADMIN_RUNTIME_TOKEN=REPLACE_WITH_DH_ADMIN_RUNTIME_API_TOKEN

# ---- 云端 TTS / LLM（按需选用，未配置则对应功能不可用）----
DASHSCOPE_API_KEY=REPLACE_ME
TENCENT_APPID=REPLACE_ME
TENCENT_SECRET_KEY=REPLACE_ME
TENCENT_SECRET_ID=REPLACE_ME
DOUBAO_API_KEY=REPLACE_ME
AZURE_SPEECH_KEY=REPLACE_ME
AZURE_TTS_ENDPOINT=REPLACE_ME
